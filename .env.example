# ===================================================
# Skill-Swap Environment Configuration Template (.env.example)
# ===================================================

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=skill_swap

# Django Backend Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Tokens
JWT_SECRET=replace-with-a-secure-random-key
JWT_SIGNING_KEY=replace-with-a-secure-random-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Email Service (Gmail SMTP for OTP Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ZegoCloud SDK
ZEGO_APP_ID=your-zego-app-id
ZEGO_SERVER_SECRET=your-zego-server-secret

# Socket.io Service Configuration
PORT=4100
SOCKET_SERVICE_URL=http://localhost:4100
DJANGO_API_URL=http://localhost:8000/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Exposed via Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SOCKET_URL=http://localhost:4100
VITE_ZEGO_APP_ID=your-zego-app-id
